<header>
    <nav class="navbar is-transparent">
        <div class="navbar-brand">
            <a class="navbar-item" href="/">
                Portfolio Manager
            </a>
            <div class="navbar-burger js-burger" data-target="navbar-menu">
                <span></span>
                <span></span>
                <span></span>
